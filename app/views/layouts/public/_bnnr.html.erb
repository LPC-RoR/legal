<%= render partial: 'layouts/public/ticker', locals: {dsply: false} %>

<div class="mx-3">
  <nav class="navbar navbar-expand-xl navbar-light overlay-nav">
    <div class="container-fluid px-3">

      <!-- Botón hamburguesa -->
      <button class="navbar-toggler order-0 me-2 p-1" type="button"
              data-bs-toggle="collapse" data-bs-target="#heroNav"
              aria-controls="heroNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon" style="width: 1em; height: 1em;"></span>
      </button>

      <!-- Logo: versión móvil (pequeña) -->
      <%= render layout: '0p/tltp_lnk', locals: {lnk: root_path, tltp: nil} do %>
        <%= image_tag 'logo/logo_130.png',
            class: 'img-fluid d-md-none',
            style: 'max-height: 40px;' %>
      <% end %>

      <!-- Logo: versión desktop -->
      <%= render layout: '0p/tltp_lnk', locals: {lnk: root_path, tltp: nil} do %>
        <%= image_tag 'logo/logo_130.png',
            class: 'img-fluid d-none d-md-block' %>
      <% end %>

      <!-- Ítems de menú -->
      <div class="collapse navbar-collapse order-last" id="heroNav">

        <!-- CENTRO -->
        <ul class="navbar-nav mx-auto align-items-xl-center">
          <% unless action_name == 'index' %>
            <li class="nav-item">
              <%= link_to 'Inicio', root_path, class: 'nav-link fs-6 text-nowrap' %>
            </li>
          <% end %>

          <% unless action_name == 'metodologia' %>
            <li class="nav-item">
              <%= link_to 'Metodología', '/metodologia', class: 'nav-link fs-6 text-nowrap' %>
            </li>
          <% end %>

          <% unless action_name == 'laborsafe' %>
            <li class="nav-item">
              <%= link_to 'Plataforma', '/laborsafe', class: 'nav-link fs-6 text-nowrap' %>
            </li>
          <% end %>

          <% unless action_name == 'equipo' %>
            <li class="nav-item">
              <%= link_to 'Equipo', '/equipo', class: 'nav-link fs-6 text-nowrap' %>
            </li>
          <% end %>

          <% unless action_name == 'capacitaciones' %>
            <li class="nav-item">
              <%= link_to 'Capacitaciones', capacitaciones_path, class: 'nav-link fs-6 text-nowrap' %>
            </li>
          <% end %>

          <% unless action_name == 'simulador' %>
            <li class="nav-item">
              <%= link_to 'Simulador', '/simulador', class: 'nav-link fs-6 text-nowrap' %>
            </li>
          <% end %>
        </ul>

        <ul class="navbar-nav ms-auto align-items-xl-center">
          <li class="nav-item">
            <%= link_to 'Iniciar sesión', new_usuario_session_path, class: 'nav-link fs-6 text-nowrap' %>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</div>