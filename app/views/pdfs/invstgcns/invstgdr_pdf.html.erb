<% code = 'invstgdr' %>
<% dstntr   = @opciones[:anonimizar] ? @act.ownr : @ownr %>
<%= render partial: 'pdfs/invstgcns/head_ttl', locals: {code: code} %>
<%= render partial: 'pdfs/invstgcns/dstntr_rfrnc', locals: {dstntr: dstntr, pdf: @pdf, annm: @opciones[:anonimizar]} %>
<%= render partial: 'pdfs/invstgcns/nota_annm', locals: {dstntr: dstntr} if @opciones[:anonimizar] %>

<% invstgdr_nombre  = @opciones[:anonimizar] ? @objeto.krn_investigador.kywrd[:krn] : @objeto.krn_investigador.krn_investigador %>

<% invstgdr_email   = @opciones[:anonimizar] ? '[INSTGDR-EMAIL]' : @objeto.krn_investigador.email %>

<div class="mt-5">
  <p>De nuestra consideración:</p>

  <p>
    Por medio de la presente, informamos que el(la) Sr(a) <%= invstgdr_nombre %> ha sido designado(a) como investigador(a) en el procedimiento individualizado en la referencia.</p>

  <p>Para efectos del presente procedimiento, usted participa en calidad de <%= @ownr.kywrd[:rol] %>.</p>

  <p>
    A partir de este momento, la investigadora designada queda a su disposición para resolver cualquier consulta a través de la casilla de correo electrónico <%= invstgdr_email %>
  </p>

  <p>Sin otro particular, le saluda atentamente</p>
</div>

<%= render partial: 'pdfs/invstgcns/firma_rcpcn', locals: {emprs: @empresa} %>