<% lst.each do |act| %>
	<% nombre = act.nombre.present? ? act.nombre : mdl.nombre[code] %>

	<%# Se puede crear un registro que no tenga PDF, como una forma de marcar como realizado %>
	<%# Se diferencia un PDF generado de uno subido (upload) %>
	<%# TODO lo anterior tiene un look diferenciado %>
	<% if act.pdf.attached? %>
		<% clr = act.crtn_mode == 'upload' ? 'text-success' : 'text-primary' %>
	<% else %>
		<% clr = 'text-secondary' %>
	<% end %>

	<div class="row gx-1 <%=clr%>">
		<div class="col-10">
			<i class="bi bi-arrow-return-right"></i> 
			<% if act.sndd %>
				<i class="bi bi-send-check"></i>
			<% end %>
			<% if act.no_annm %>
				<i class="bi bi-highlighter"></i>
			<% end %>
			<%= dma_hm(act.created_at) %> <%= nombre %>
		</div>
		<div class="col-2 text-end objt_lnk">
			<% if act.pdf.attached? %>
				<% unless ClssPdfInvstgcns.no_sndng_code?(act.act_archivo) || act.sndd %>
					<%= render layout: '0p/tltp_lnk', locals: {lnk: "/act_archivos/#{act.id}/enviar_pdf_por_email", tltp: 'Enviar por correo electrónico', data: {turbo_method: :post, turbo_confirm: "Confirmar envío del email"}} do %>
						<i class="bi bi-envelope-paper"></i>
					<% end %>
				<% end %>
				<%=render partial: '0t/lnk_dwnld', locals: {objt: act, tltp: "Bajar PDF"} %>
			<% else %>
				<i class="bi bi-ban text-danger"></i>
			<% end %>
			<%=render partial: '0t/lnk_editar', locals: {objt: act} if act.crtn_mode == 'upload' %>
			<%=render partial: '0t/lnk_eliminar', locals: {objt: act} %>
		</div>
	</div>

	<%# Anonimización de ActArchivo generado desde un TxtEditable %>
	<% if ClssAnnmInvstgcns::ANNM_COPY_TXT.include?(act.act_archivo) %>
		<% txt_objt = act.txt_anonimizado %>
		<div class="mx-3">
			<div class="row gx-1">
				<div class="col-10">
					<i class="bi bi-arrow-return-right"></i> 
					<% if txt_objt.present? %>
						Anonimizado
					<% else %>
						Sin anonimizado
					<% end %>
				</div>
				<div class="col-2 text-end objt_lnk">
					<% if txt_objt.present? %>
						<%=render partial: '0t/lnk_editar', locals: {objt: txt_objt} %>
						<%=render partial: '0t/lnk_eliminar', locals: {objt: txt_objt} %>
					<% else %>
						<%= render layout: '0p/tltp_lnk', locals: {lnk: "/act_archivos/#{act.id}/preparar_anonimizacion", tltp: "Generar Texto anonimizado", data: {turbo_method: :post}} do %>
							<i class="bi bi-marker-tip"></i>
						<% end %>
					<% end %>
				</div>
			</div>
		</div>
	<% end %>

<% end %>