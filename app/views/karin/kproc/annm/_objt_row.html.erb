<% nombre = ClssAnnmInvstgcns.nombre[code] %>

<div class="row gx-1">
	<div class="col-10">
		<i class="bi bi-file-text"></i>
		<% clr_cone = ClssAnnmInvstgcns.optnl_code?(code) ? 'primary' : 'danger' %>
		<% if lst.none? %><small><i class="bi bi-cone-striped text-<%=clr_cone%>"></i></small><% end %>
		<%= nombre %>
	</div>
	<div class="col-2 text-end objt_lnk">
		<% unless lst.any? %>
			<%= render partial: '0p/tbl/lnk_new', locals: {source: 'txt_editables', ownr: ownr, prms: {cdg: code}} %>
			<%= render layout: '0p/tltp_lnk', locals: {lnk: "/#{ownr.class.table_name}/#{ownr.id}/anonimizar_expediente?g=#{code}", tltp: "Anonimizar", data: {turbo_method: :patch, turbo_confirm: "Confirmar anonimización"}} do %>
				<i class="bi bi-sunglasses"></i>
			<% end %>
		<% end %>
	</div>
</div>