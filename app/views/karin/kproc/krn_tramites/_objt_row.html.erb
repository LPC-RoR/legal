<% nombre = KrnTramite.nombre[code] %>

<div class="row gx-1">
	<div class="col-10">
		<i class="bi bi-file-pdf"></i>
		<% if lst.none? %><small><i class="bi bi-cone-striped text-danger"></i></small><% end %>
		<%= nombre %>
	</div>
	<div class="col-2 text-end objt_lnk">
		<% unless lst.any? %>
			<%= render layout: '0p/tltp_lnk', locals: {lnk: "/krn_tramites/new#{blngs_prms(ownr)}&code=#{code}", tltp: 'Crear Trámite'} do %>
				<i class="bi bi-plus-circle"></i>
			<% end %>
		<% end %>
	</div>
</div>