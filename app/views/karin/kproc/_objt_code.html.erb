<% nombre = mdl.nombre[code] %>

<div class="row gx-1">
	<div class="col-10">
		<i class="bi bi-file-pdf"></i>
		<%= nombre %>
	</div>
	<div class="col-2 text-end objt_lnk">
		<%= render layout: '0p/tltp_lnk', locals: {lnk: "/act_archivos/new?code=#{code}", tltp: 'Subir PDF'} do %>
			<i class="bi bi-upload"></i>
		<% end %>
		<% unless ClssPdf.txt_code?(code) %>
			<%= render layout: '0p/tltp_lnk', locals: {lnk: "/#{ownr.class.table_name}/#{ownr.id}/generar_ownr_pdf?code=#{code}", tltp: "Generar pdf", data: {turbo_method: :post}} do %>
				<i class="bi bi-file-pdf"></i>
			<% end %>
		<% end %>
	</div>
</div>