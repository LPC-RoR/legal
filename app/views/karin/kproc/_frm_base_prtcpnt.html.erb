<div class="row gx-1">
	<div class="col-2">
		<%= render partial: '0inpts/text', locals: { f: f, tkn: :rut, label: 'Cédula de identidad' } %>
	</div>
	<div class="col-5">
		<%= render partial: '0inpts/text', locals: { f: f, tkn: :nombre, label: 'Nombre completo' } %>
	</div>
	<div class="col-5">
		<%= render partial: '0inpts/email', locals: { f: f, tkn: :email, label: 'Email personal' } %>
	</div>
</div>

<% if @objeto.dnnc.ownr.plan_type == 'extendido' %>
	<!-- EMPLEADO EXTERNO -->
	<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :empleado_externo, label: 'Empleado externo', data: { 
	            prtcpnts_fields_target: "empresaCheckbox",
	            action: "change->prtcpnts-fields#updateFields"
	          }} %>
<% end %>

<div data-prtcpnts-fields-target="empresaField" 
   style="display: <%= f.object.empleado_externo? ? 'block' : 'none' %>">
	  <%= render "krn_empresa_externa_id", form: f %>
</div>

<div class="row gx-1">
	<div class="col-4">
		<%= render partial: '0inpts/text', locals: { f: f, tkn: :cargo, label: 'Cargo/Relación laboral' } %>
	</div>
	<div class="col-4">
		<%= render partial: '0inpts/text', locals: { f: f, tkn: :lugar_trabajo, label: 'Lugar de trabajo' } %>
	</div>
	<div class="col-4">
		<%= render partial: '0inpts/text', locals: { f: f, tkn: :telefono, label: 'Teléfono personal' } %>
	</div>
</div>

<% unless @objeto.is_a?(KrnTestigo) %>
	<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :articulo_4_1, label: 'Aplica artículo 4 inciso primero del Código del Trabajo'} %>
<% end %>

<!-- ARTÍCULO 516 -->
<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :articulo_516, label: 'Aplica artículo 516 del Código del Trabajo', data: { 
            prtcpnts_fields_target: "articuloCheckbox",
            action: "change->prtcpnts-fields#updateFields"
          }} %>

<div data-prtcpnts-fields-target="articuloField" 
   style="display: <%= f.object.articulo_516? ? 'block' : 'none' %>">
	  <%= render "direccion", form: f %>
</div>

<% unless @objeto.dnnc.etapa == 'etp_rcpcn' %>
	<%= render '0inpts/date', f: f, tkn: :fecha_dnnc_crrgd, label: 'Plazo para presentar la denuncia corregida' %>
	<%= render partial: '0inpts/select', locals: { f: f, tkn: :dclrcn_intrrmpd, sel_list: ['No se presenta', 'No firma declaración'], include_blank: 'Sin interrupcion', label: 'El participante interrumple el proceso de declaración:'} %>
<% end %>