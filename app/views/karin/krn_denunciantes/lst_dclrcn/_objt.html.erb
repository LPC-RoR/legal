<% email_verificado = objt.tiene_email_verificado? %>
<% email_validado 	= objt.tiene_email_validado? %>
<% articulo_516 	= !!objt.articulo_516 %>

<% clr = email_verificado || articulo_516 ? 'text-primary' : (email_validado ? 'text-success' : 'text-secondary')  %>

<b class="<%=clr%>">
<%= s_rut(objt.rut) %>
<i class="bi bi-dot"></i>
<%= objt.nombre %>
<i class="bi bi-dot"></i>
<%= articulo_516 ? objt.direccion_notificacion : email_mask(objt.email) %>
</b> 
<% unless objt.dclrcn_intrrmpd.nil? %>
	<i class="bi bi-dot"></i>
	<span class="text-danger"><%= objt.dclrcn_intrrmpd %></span>
<% end %>