<h5><%= @form.to_model.ownr.razon_social %></h5>

<% if @form.etapa == 'etp_rcpcn' %>

	<%= render '0inpts/datetime', f: f, tkn: :fecha_hora, label: 'Fecha y hora de la denuncia' %>

	<%= render partial: '0inpts/text', locals: { f: f, tkn: :identificador, label: 'Identificador de la denuncia' } %>

	<div class="row gx-1">
		<div class="col-lg-3 col-xs-12">
			<%= render partial: '0inpts/select', locals: { f: f, tkn: :motivo_denuncia, sel_list: KrnDenuncia::MOTIVOS, label: 'Motivo de la denuncia' } %>
		</div>
		<div class="col-lg-3 col-xs-12">
	  <!-- Grupo condicional para empresa_externa -->
				<%= render partial: '0inpts/select', locals: { f: f, tkn: :receptor_denuncia, sel_list: KrnDenuncia::RECEPTORES, label: 'Receptor de la denuncia', data: { 
	              'conditional-fields-target': 'receptorDenuncia',
	              action: 'change->conditional-fields#toggleEmpresaExterna'
	            } } %>
		</div>
		<div class="col-lg-3 col-xs-12">
			<%= render partial: '0inpts/select', locals: { f: f, tkn: :via_declaracion, sel_list: KrnDenuncia::VIAS_DENUNCIA, label: 'Canal de denuncia', data: { 'conditional-fields-target': 'viaDeclaracion', action: 'change->conditional-fields#toggleTipoDeclaracion'} } %>
		</div>
		<div class="col-lg-3">
			<%= render partial: '0inpts/select', locals: { f: f, tkn: :presentado_por, sel_list: KrnDenuncia::TIPOS_DENUNCIANTE, label: 'Quien denuncia', data: { 
	              'conditional-fields-target': 'presentadoPor',
	              action: 'change->conditional-fields#toggleRepresentante'
	            } } %>
		</div>

	</div>

	<div data-conditional-fields-target="empresaExternaGroup" hidden>
		  <%= render "krn_empresa_externa_id", f: f %>
	</div>

	<div data-conditional-fields-target="tipoDeclaracionGroup" hidden>
	  <%= render "tipo_declaracion", f: f %>
	</div>

	<div data-conditional-fields-target="representanteGroup" hidden>
	  <%= render "representante", f: f %>
	</div>

	<div class="row gx-1">
		<div class="col-lg-6 col-xs-12">
			<%= render partial: '0inpts/text', locals: { f: f, tkn: :lugar_ocurrencia, label: 'Lugar donde ocurre los hechos' } %>
		</div>
		<div class="col-lg-6 col-xs-12">
			<%= render partial: '0inpts/text', locals: { f: f, tkn: :direccion_ocurrencia, label: 'Dirección donde ocurre los hechos' } %>
		</div>
	</div>

	<div class="row gx-1">
		<div class="col-lg-6 col-xs-12">
			<%= render partial: '0inpts/select', locals: { f: f, tkn: :dnncnt_optn_invstgcn, sel_list: ['Empresa', 'Direccion del Trabajo'], label: 'La persona denunciante manifiesta su opción que la denuncia sea investigada por:'} %>
		</div>
		<div class="col-lg-6 col-xs-12">
			<%= render partial: '0inpts/select', locals: { f: f, tkn: :emprs_optn_invstgcn, sel_list: ['Empresa', 'Direccion del Trabajo'], include_blank: 'Pendiente', label: 'La empresa manifiesta su opción que la denuncia sea investigada por:'} %>
		</div>
	</div>

	<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :vrfccn_dts_incmbnts, label: 'Se han verificado y completado los datos de los incumbentes.'} %>

<% elsif @form.etapa == 'etp_invstgcn' %>
	<%= render partial: '0inpts/select', locals: { f: f, tkn: :evlcn_dnnc, sel_list: ['Sin observaciones', 'Con observaciones'], include_blank: 'Sin evaluar', label: 'Evaluación de la denuncia por el investigador:'} %>

	<%= render '0inpts/date', f: f, tkn: :fecha_dnnc_crrgd, label: 'Plazo para presentar la denuncia corregida' %>

	<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :vrfccn_dts_tstgs, label: 'Se han verificado y completado los datos de los testigos.'} %>

	<%= render '0inpts/date', f: f, tkn: :fecha_termino_investigacion, label: 'Fecha en la que terminó la investigación' %>
<% elsif @form.etapa == 'etp_prnncmnt' %>
	<%= render '0inpts/date', f: f, tkn: :fecha_recepcion_pronunciamiento, label: 'Fecha en la que recibió el pronunciamiento' %>
	<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :prnncmnt_vncd, label: 'Ha vencido el plazo para el pronunciamiento de la Direccón del Trabajo'} %>
<% else %>
	<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :causal_establecida, label: 'Causal acreditada'} %>
<% end %>

<%= render partial: '0inpts/hidden_ownr', locals: { f: f } %>