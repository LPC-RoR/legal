<%#= @kproc.etapa %>
<%#= @kproc.tarea %>
<div class="shadow mx-1 mt-1 border-1 border-secondary rounded-2 bg_azul_claro clr_azul_oscuro">

	<div class="border-bottom mx-1 my-1 px-2 py-1 rounded-2 fw-bold">
		<div class="row">
			<div class="col-8 fs-6"><i class="bi bi-caret-right-fill"></i> Etapa  <small><i class="bi bi-caret-right"></i> Tarea</small> </div>
			<div class="col-4 pe-4 text-end fs-6">Plazo</div>
		</div>
	</div>

	<div class=" px-4 py-2">
		<div class="row gx-1 fs-6">
			<div class="col-8">
				<div class="d-flex justify-content-start gap-1 text-dark">
					<i class="bi bi-caret-right-fill"></i><b><%= ClssPrcdmnt.act_nombre[@kproc.etapa.to_s] %></b>
				</div>
			</div>
			<!-- Etapa del procedimiento cerrado no tiene plazo -->
			<div class="col-4 text-end">
				<% if @kproc.plazo %>
					<% ontime = Time.zone.today <= @kproc.plazo %>
					<% if ontime %>
						<i class="bi bi-calendar-check text-primary"></i>
					<% else %>
						<i class="bi bi-calendar-x text-danger"></i>
					<% end %>
					<span class="text-<%=ontime ? 'primary' : 'danger'%>"><%= dma(@kproc.plazo) %></span>
				<% else %>
					-
				<% end %>
			</div>
		</div>

		<div class="ps-4 objt_lnk">
			<b><i class="bi bi-caret-right"></i><%= ClssPrcdmnt.act_nombre[@kproc.tarea] %></b>
			<%= render layout: '0p/collapse/link', locals: {label: 'DetalleTarea', objeto: nil, tooltip: nil} do %>
				<small>Detalle <i class="bi bi-arrow-bar-down"></i></small>
			<% end %>

			<% if prtl?('karin', 'kproc/hnts', @kproc.tarea) %>
				<%= render layout: '0p/collapse/dsply', locals: {label: 'DetalleTarea', objeto: nil} do %>
					<div class="ps-2">
						<%= render partial: prtl('karin', 'kproc/hnts', @kproc.tarea) %>
					</div>
				<% end %>
			<% end %>
		</div>
	</div>



</div>