<%# krn_denuncias/shw/_cambio_estado.html.erb %>

<div class="border rounded-2 m-1 p-1">

  <div class="row gx-1">
    <div class="col-8"><h6 class="px-1"><b>Etapa</b></h6></div>
    <div class="col-4 text-end"><h6 class="px-1"><b>Plazo</b></h6></div>
  </div>

  <div class="row gx-1 py-2">
    <div class="col-8">
      <h6><b><i class="bi bi-caret-right-fill"></i> <%= ClssPdfInvstgcns.etp_nombre[@objeto.etapa.to_sym] %></b></h6>
    </div>
      <div class="col-4 text-end">
        <h6>
          <% if @objeto.plazo_actual.present? && @objeto.plazo_actual[:fecha_limite].present? %>
            <% plazo    = @objeto.plazo_actual[:fecha_limite] %>
            <% cmplmnt  = @objeto.plazo_actual[:fecha_cumplimiento] || Time.zone.today %>
            <% ontime   = cmplmnt <= plazo %>
            <% clr      = ontime ? 'primary' : 'danger' %>
            <% clndr    = ontime ? 'check' : 'x' %>
            <div class="text-<%= clr %> fw-bold">
              <i class="bi bi-calendar-<%= clndr %>"></i>
              <%= dma(plazo) %>
            </div>
          <% else %>
            <div class="text-muted fw-bold">
              <i class="bi bi-check-circle"></i> Cerrada
            </div>
          <% end %>
        </h6>
      </div>
  </div>
  

  <!-- Barra de estados tipo stepper -->
  <div class="etapa-stepper d-flex align-items-center gap-1 p-3 bg-light rounded overflow-auto">
    <% KrnDenuncia::ETAPAS.each_with_index do |etapa_key, idx| %>
      <% is_current = (@objeto.etapa == etapa_key) %>
      <% idx_actual = KrnDenuncia::ETAPAS.index(@objeto.etapa) %>
      <% is_next  = (idx == idx_actual + 1) %>
      <% is_prev  = (idx == idx_actual - 1) %>
      <% enabled  = (is_next && @objeto.puede_avanzar?) ||
                     (is_prev && current_usuario.admin? && @objeto.may_retroceder?) %>

      <%= button_to etapa_nombre(etapa_key),
                    cambiar_etapa_krn_denuncia_path(@objeto, etapa_destino: etapa_key),
                    method: :patch,
                    class: "step-btn #{stepper_classes(@objeto, etapa_key)}",
                    disabled: !enabled && !is_current,
                    form: { class: "d-inline" },
                    data: { confirm: "¿Cambiar a #{etapa_nombre(etapa_key)}?" } %>

      <% unless idx == KrnDenuncia::ETAPAS.size - 1 %>
        <span class="step-arrow mx-1 text-muted">→</span>
      <% end %>
    <% end %>
  </div>

  <div class="mt-2 px-5 fw-bold objt_lnk">
    <i class="bi bi-caret-right"></i> Tarea: <%= ClssPdfInvstgcns.tsk_nombre[@kproc.tarea] %>

    <% if prtl?('karin', 'kproc/hnts', @kproc.tarea) %>
      <%= render layout: '0p/collapse/link', locals: {label: 'DetalleTarea', objeto: nil, tooltip: nil} do %>
        <small>Detalle <i class="bi bi-arrow-bar-down"></i></small>
      <% end %>

      <%= render layout: '0p/collapse/dsply', locals: {label: 'DetalleTarea', objeto: nil} do %>
        <div class="ps-2">
          <%= render partial: prtl('karin', 'kproc/hnts', @kproc.tarea) %>
        </div>
      <% end %>
    <% end %>

  </div>

</div>