<% clccn  = @objeto.krn_declaraciones %>

<% ntfccns = objt.act_referencias.where(code: 'dclrcn') %>




<% unless ntfccns&.any? %>
  <li>
    <%= render layout: '0p/tltp_lnk', locals: {lnk: "/krn_declaraciones/#{objt.id}/cargar_pdf?code=dclrcn", tltp: 'Generar PDF', data: {turbo_method: :post, turbo_confirm: 'generación del PDF'}, clss: 'dropdown-item'} do %>
      Generar citación
    <% end %>
  </li>
<% end %>


<%# unless (clccn.count == 2 and objt == clccn.first) or objt.objetado or @objeto.fecha_trmn? %>
  <% if current_usuario.operacion? %>

    <% unless ntfccns&.any? %>
      <li><hr class="dropdown-divider"></li>
    <% end %>
    <%= render partial: '0p/tbl/plldwn_editar', locals: {objt: objt, orgn: @orgn} %>

    <%# No se puede eliminar una asignación objetada %>
    <% unless ntfccns&.any? %>
      <li><hr class="dropdown-divider"></li>
      <%= render partial: '0p/tbl/plldwn_eliminar', locals: {objt: objt, orgn: @orgn} %>
    <% end %>

  <% end %>
<%# end %>