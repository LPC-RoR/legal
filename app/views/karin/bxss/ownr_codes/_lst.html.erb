<div class="p-2">

	<%# --------------------------------------------- shw_ntfccns %>
	<% if @indx == 1 %>
		<% if ownr.is_a?(KrnDenunciante) %>
			<% dnncnt_cdgs = codes & ClssPdfInvstgcns::DNNCNT_CDGS %>
			<b class="pt-2 ps-3">De la recepción de la denuncia</b><br>
			<% dnncnt_cdgs.each do |code| %>
				<%= render partial: 'karin/kproc/objeto_cntxt_ownr', locals: {code: code, mdl: ClssPdfInvstgcns, ownr: ownr} %>
			<% end %>
		<% end %>

		<% if ownr.is_a?(KrnDenunciante) || ownr.is_a?(KrnDenunciado) %>
			<% incmbnts_cdgs = codes & ClssPdfInvstgcns::INCMBNTS_CDGS %>
			<b class="pt-2 ps-3">De los participantes</b><br>
			<% incmbnts_cdgs.each do |code| %>
				<%= render partial: 'karin/kproc/objeto_cntxt_ownr', locals: {code: code, mdl: ClssPdfInvstgcns, ownr: ownr} %>
			<% end %>
		<% end %>

		<% if ownr.is_a?(KrnDenunciante) || ownr.is_a?(KrnDenunciado) || ownr.is_a?(KrnTestigo) %>
			<% prtcpnts_cdgs = codes & ClssPdfInvstgcns::PRTCPNTS_CDGS %>
			<b class="pt-2 ps-3">Medios de prueba</b><br>
			<% prtcpnts_cdgs.each do |code| %>
				<%= render partial: 'karin/kproc/objeto_cntxt_ownr', locals: {code: code, mdl: ClssPdfInvstgcns, ownr: ownr} %>
			<% end %>
		<% end %>
	<% else %>
		<% codes.each do |code| %>
			<%= render partial: 'karin/kproc/objeto_cntxt_ownr', locals: {code: code, mdl: ClssPdfInvstgcns, ownr: ownr} %>
		<% end %>
	<% end %>

</div>