<% clccn  = @objeto.krn_inv_denuncias %>

<% ntfccns = objt.act_referencias.where(code: 'invstgdr') %>
<% dsgncn = objt.act_referencias.find_by(code: 'txt_dsgncn') %>

<% estd_1 = ntfccns.any? ? "notificado (#{ntfccns.count})" : 'sin notificar' %>
<% estd_2 = dsgncn.present? ? 'sin designación' : "designado" %>


<%# Notificación: a menos que sea el investigador objetado %>
<%# Manejo de notificaciones no se despliega en un investigador objetado %>
<% unless objt.objetado %>

  <% unless ntfccns&.any? %>
    <li>
      <%= render layout: '0p/tltp_lnk', locals: {lnk: "/krn_inv_denuncias/#{objt.id}/cargar_pdf?code=invstgdr", tltp: 'Generar PDF', data: {turbo_method: :post, turbo_confirm: 'generación del PDF'}, clss: 'dropdown-item'} do %>
        Generar PDF notificaciones
      <% end %>
    </li>
  <% end %>

  <% unless dsgncn %>
    <li>
      <%= render layout: '0p/tltp_lnk', locals: {lnk:"/krn_denuncias/#{@objeto.id}/cargar_pdf?code=txt_invstgdr_dsgncn", tltp: 'Generar PDF', data: {turbo_method: :post, turbo_confirm: 'Confirmar generación del PDF'}, clss: 'dropdown-item'} do %>
        Generar declaración
      <% end %>
    </li>
  <% end %>

<% end %>

<%# unless (clccn.count == 2 and objt == clccn.first) or objt.objetado or @objeto.fecha_trmn? %>
  <% if current_usuario.operacion? %>

    <% unless objt.objetado %>
      <li><hr class="dropdown-divider"></li>
    <% end %>
    <%= render partial: '0p/tbl/plldwn_editar', locals: {objt: objt, orgn: @orgn} %>

    <%# No se puede eliminar una asignación objetada %>
    <% unless objt.objetado %>
      <li><hr class="dropdown-divider"></li>
      <%= render partial: '0p/tbl/plldwn_eliminar', locals: {objt: objt, orgn: @orgn} %>
    <% end %>

  <% end %>
<%# end %>