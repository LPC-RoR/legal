<% invstgdrs = @objeto&.krn_denuncia&.ownr&.krn_investigadores.order(:krn_investigador).to_options_hash %>
<%= render partial: '0inpts/select_code', locals: {f: f, tkn: :krn_investigador_id, hsh: invstgdrs, label: 'Investigador' } %>

<% if action_name == 'edit' %>
	<% unless @objeto.objecion_rslcn.present? %>
		<%= render partial: '0inpts/check_box', locals: {f: f, tkn: :objetado, label: 'Investigador(a) objetado(a)' } %>
	<% end %>
	<% if @objeto.objetado %>
		<%= render partial: '0inpts/select', locals: {f: f, tkn: :objecion_rslcn, sel_list: ['Aceptada', 'Rechazada'], include_blank: 'Sin resolución', label: 'Resolución de la objeción' } %>
	<% end %>
<% end %>

<%= render partial: '0inpts/hidden_lst', locals: { f: f, hddn_lst: [:krn_denuncia_id] } %>