<% objeto.tar_facturaciones.each do |objt| %>
	<%= render partial: prtl('tar_facturaciones', 'list', 'objeto'), locals: {objeto: objt} %>
<% end %>
<div class="fw-bold">PDF Aprobación</div>
<% aprobaciones = objeto.act_archivos.where(act_archivo: 'aprobacion') %>
<% if aprobaciones.any? %>
	<div class="mx-3">
		<%= render partial: '0t/tbl', locals: {source: 'act_archivos', clccn: aprobaciones, dir: 'pdf'} %>
	</div>
<% else %>
	<div class="mx-3"><i class="bi bi-cone-striped text-danger"></i> Aprobación sin PDF generado.</div>
<% end %>
<div class="fw-bold">Factura(s)</div>
<% if objeto.doc_emitidos.any? %>
	<div class="mx-3"><i class="bi bi-arrow-right"></i> <%= objeto.doc_emitidos.map {|doc| doc.folio}.join('-') %></div>
<% else %>
	<div class="mx-3"><i class="bi bi-arrow-right"></i> Sin conciliar</div>
<% end %>
<hr>