<%# Conversión: ahora se dispara al confirmar el correo (humano real),
    no al enviar el formulario. Crea la acción "Formulario diagnostico"
    en Google Ads y reemplaza el label de abajo. %>
<% if params[:conv] == "contacto" %>
  <script>
    gtag('event', 'conversion', {'send_to': 'AW-18468802388/UxFkCJ6dtoUdENSezuZE'});
  </script>
<% elsif params[:conv] == "diagnostico" %>
  <script>
    gtag('event', 'conversion', {'send_to': 'AW-18468802388/REEMPLAZAR_CON_LABEL_DIAGNOSTICO'});
  </script>
<% end %>

<div class="ubuntu-regular" style="max-width: 560px; margin: 4rem auto; text-align: center;">
  <% if params[:pendiente_confirmacion] %>
    <h1>Revisa tu correo</h1>
    <p>Te enviamos un enlace para confirmar tu dirección. Sin esa confirmación
    no podemos enviarte tu resultado ni contactarte.</p>
  <% else %>
    <h1>¡Solicitud recibida!</h1>

    <% if params[:conv] == "diagnostico" %>
      <p>Te enviamos tu resultado por correo. El siguiente paso es una demo de 30 minutos.</p>
      <p style="margin: 2rem 0;">
        <%= link_to "Agendar ahora mi demo de 30 minutos",
                    "https://www.laborsafe.cl/#contacto",
                    class: "btn btn-sm btn-primary" %>
      </p>
    <% else %>
      <p>Un especialista te contactará dentro de las próximas 24 horas hábiles para agendar
      tu demo de 30 minutos.</p>
    <% end %>
  <% end %>

  <%= link_to "Volver al inicio", root_path, class: "btn btn-sm btn-outline-primary" %>
</div>