<%# app/views/comercial/lead_mailer/confirmacion_email.html.erb %>
<h2>Un último paso, <%= @lead.nombre %></h2>

<p>Recibimos tu solicitud en <a href="https://www.laborsafe.cl">laborsafe.cl</a>.
Para enviarte tu <%= @lead.diagnostico? ? "resultado de autodiagnóstico" : "confirmación de agendamiento" %>
y poder contactarte, necesitamos que confirmes que este correo es tuyo:</p>

<p style="margin:2rem 0;text-align:center;">
  <%= link_to "Confirmar mi correo",
              confirmar_leads_url(token: @lead.confirmacion_token),
              style: "background:#0d6efd;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;" %>
</p>

<p style="font-size:12px;color:#9ca3af;">
  Si no fuiste tú quien envió esta solicitud, no hagas clic y ignora este correo:
  no te enviaremos nada más.
</p>

<%= render "firma" %>