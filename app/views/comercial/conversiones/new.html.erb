<%# app/views/admin/conversiones/new.html.erb %>
<h2>Convertir lead en Empresa</h2>
<p>Lead: <strong><%= @lead.nombre %></strong> (<%= @lead.email %>)</p>

<%= form_with(model: @empresa, url: admin_lead_conversion_path(@lead)) do |form| %>
  <% if @empresa.errors.any? %>
    <div class="error-messages">
      <% @empresa.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= render partial: '0p/lbld_inpts/text', locals: { form: form, token: :rut, label: 'RUT de la empresa', objeto: @empresa, mrgn_bttm: 1 } %>
  <%= render partial: '0p/lbld_inpts/text', locals: { form: form, token: :razon_social, label: 'Razón social', objeto: @empresa, mrgn_bttm: 1 } %>

  <div class="actions">
    <%= form.submit "Crear Empresa", class: "btn btn-sm btn-outline-primary" %>
  </div>
<% end %>