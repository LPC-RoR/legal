<% cntxt_clss = @objeto.cntxt_clss.constantize %>
<% clss_lst   = cntxt_clss.dsply_codes_for(@objeto.ownr) %>

<div class="mb-3">

  <%= f.label :codigo, "Formato", class: "form-label" %>
  <div class="mb-3">
    <%= f.label :codigo, "Código", class: "form-label" %>
    <%= f.text_field :codigo, 
                       class: "form-control",
                       placeholder: "Código",
                       readonly: true %>
  </div>
</div>

<div class="mb-3">
  <%= f.label :titulo, "Título", class: "form-label" %>
  <%= f.text_field :titulo, 
                     class: "form-control",
                     placeholder: "Título del reporte" %>
</div>

<div class="mb-3">
  <%= f.label :contenido, "Texto", class: "form-label" %>
  <%# Trix editor nativo de Rails 8 %>
  <%= f.rich_text_area :contenido, 
                      class: "trix-content",
                      placeholder: "Escribe o pega el contenido aquí...",
                      data: { 
                        # Permite pegar desde Word/Google Docs
                        action: "trix-paste->editor#sanitize" 
                      } %>
  
  <small class="form-text text-muted">
    Puedes pegar contenido desde Word o Google Docs. 
    Usa los botones de la barra para listas, negritas, etc.
  </small>
</div>

<%= render partial: '0inpts/hidden_lst', locals: { f: f, hddn_lst: [:ownr_type, :ownr_id, :cntxt_clss] } %>