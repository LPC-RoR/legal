<h5 class="text-primary"><i class="bi bi-file-earmark-arrow-up"></i> <%= @objeto.mdl.constantize.nombre[@objeto.act_archivo] %></h5>

<%# Si el archivo esperado no es único se activa el ingreso personalizado de nombre %>
<% unless @objeto.mdl.constantize.has_one?(@objeto.act_archivo)  %>
	<%= render partial: '0inpts/text', locals: { f: f, tkn: :nombre, label: 'Nombre del archivo' } %>
<% end %>

<%# Control de Fecha | Fecha hora %>
<% if @objeto.mdl.constantize.cntrl_fecha?(@objeto.act_archivo) %>
	<%= render partial: '0inpts/date', locals: { f: f, tkn: :fecha, label: 'Fecha' } %>
<% elsif @objeto.mdl.constantize.cntrl_fecha_hora?(@objeto.act_archivo) %>
	<%= render partial: '0inpts/datetime', locals: { f: f, tkn: :fecha, label: 'Fecha' } %>
<% end %>

<%= render partial: '0inpts/pdf_file', locals: { f: f, tkn: :pdf } %>

<%# if @objeto.mdl.constantize.act_lst?(@objeto.act_archivo)  %>
	<div class="mt-3">
		<%= render partial: '0inpts/check_box', locals: { f: f, tkn: :no_annm, label: 'Anonimización manual' } %>
	</div>
<%# end %>

<%= render partial: '0inpts/hidden_lst', locals: { f: f, hddn_lst: [:ownr_type, :ownr_id, :act_archivo, :mdl, :crtn_mode ] } %>