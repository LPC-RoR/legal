<div class="mx-3 py-1" style="font-size: 0.7rem;">
	<% if objeto.tar_tarifa.blank? %>
		<div><i class="bi bi-cone-striped text-danger"></i> Causa sin tarifa asignada</div>
	<% end %>
	<% if objeto.tar_valor_cuantias.empty? %>
		<div><i class="bi bi-cone-striped text-danger"></i> Causa sin cuantía</div>
	<% end %>
	<% if objeto.medida_prejudicial %>
		<div><i class="bi bi-cone-striped text-primary"></i> Medida prejudicial</div>
	<% end %>
	<% if objeto.nulidad_despido %>
		<div><i class="bi bi-cone-striped text-primary"></i> Nulidad del despido</div>
	<% end %>
</div>