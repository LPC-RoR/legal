<%# aplicacion/home/_diagnostico.html.erb %>
<%#
  Mini-diagnóstico en dos columnas:
    - Izquierda: wizard de 3 preguntas (una a la vez con JS, todas apiladas sin JS)
    - Derecha: formulario de contacto compacto, siempre visible

  Las opciones son radios nativos con el patrón .btn-check de Bootstrap:
  el estado seleccionado lo pinta CSS (:checked), sin depender de JS, y el
  valor se envía de forma nativa como lead[respuestas][clave].

  El script embebido solo hace: wizard (mostrar de a una), feedback al elegir
  y envío por fetch. Sin JavaScript todo se ve apilado y el formulario se
  envía de forma tradicional a leads_gracias, con las respuestas incluidas.

  PARA EDITAR LOS TEXTOS: modifica el array `preguntas` de abajo.
  Cada opción es [valor, etiqueta_del_botón, feedback].
  No cambie los `valor` ("si", "interno", ...) sin avisar: se guardan en la
  base de datos y los usa el scope Lead.con_denuncia_abierta.
%>
<div class="ls-diagnostico" id="ls-diagnostico" data-controller="diagnostico">
  <%= form_with model: @lead, url: leads_path,
                class: "mt-4", data: { turbo: false,
                                       diagnostico_target: "form",
                                       action: "submit->diagnostico#enviar" } do |f| %>

    <%= f.hidden_field :kind, value: "diagnostico" %>
    <%= hidden_field_tag :form_loaded_at, Time.current.to_i %>
    <%# Honeypot anti-bot: invisible para humanos %>
    <input type="text" name="website" class="ls-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

    <%# Las preguntas, etiquetas y feedbacks ahora viven en Lead::DIAGNOSTICO_PREGUNTAS
        (app/models/lead.rb). Edítalos allá; el wizard y el correo los comparten. %>
    <% preguntas = Lead::DIAGNOSTICO_PREGUNTAS %>

    <div class="alert alert-primary ls-invitacion" hidden data-diagnostico-target="invitacion">
      <strong>¡Autodiagnóstico completado!</strong>
      Ahora complete sus datos a la derecha: le enviaremos su resultado por correo de inmediato.
      Si tiene una pregunta concreta, inclúyala y se la responderemos dentro de un día hábil.
    </div>

    <div class="row g-4">
      <div class="col-lg-7">
        <% preguntas.each_with_index do |pregunta, i| %>
          <fieldset class="card shadow-sm mb-3 ls-pregunta"
                    data-ls-paso="<%= i + 1 %>" data-diagnostico-target="paso">

            <div class="card-body">
              <legend class="h6 card-title fw-bold">
                <span class="text-primary"><%= i + 1 %>/3</span> <%= pregunta[:texto] %>
              </legend>
              <div class="d-grid gap-2 mt-3" data-action="change->diagnostico#mostrarFeedback">

                <% pregunta[:opciones].each do |valor, opcion| %>
                  <% input_id = "ls_#{pregunta[:clave]}_#{valor}" %>
                  <input type="radio" class="btn-check ls-opcion-check" name="lead[respuestas][<%= pregunta[:clave] %>]"
                         id="<%= input_id %>" value="<%= valor %>" data-feedback="<%= opcion[:feedback] %>">
                  <label class="btn btn-outline-primary text-start ls-opcion" for="<%= input_id %>"><%= opcion[:etiqueta] %></label>
                <% end %>
              </div>
              <p class="ls-feedback mt-3 mb-0" hidden></p>

              <% if i < preguntas.size - 1 %>
                <button type="button" class="btn btn-primary mt-3 ls-siguiente" hidden
                        data-action="click->diagnostico#siguiente">
                  Siguiente
                </button>
              <% end %>

            </div>
          </fieldset>
        <% end %>
      </div>

      <div class="col-lg-5">
        <div class="card shadow-sm ls-form-card" data-diagnostico-target="formCard">

          <div class="card-body">
            <h3 class="h6 card-title fw-bold">Reciba su resultado por correo</h3>
            <p class="text-secondary small">
              Complete sus datos y <strong>le enviaremos de inmediato el detalle de su
              autodiagnóstico</strong> con una lectura de los próximos pasos. Si además
              escribe una pregunta, nuestro equipo se la responderá
              <strong>dentro de un día hábil</strong>.
            </p>
            <div class="row g-3">
              <div class="col-md-6">
                <%= f.label :nombre, "Su nombre", class: "form-label" %>
                <%= f.text_field :nombre, class: "form-control", required: true, autocomplete: "name" %>
              </div>
              <div class="col-md-6">
                <%= f.label :email, "Su correo de trabajo", class: "form-label" %>
                <%= f.email_field :email, class: "form-control", required: true, autocomplete: "email" %>
              </div>
              <div class="col-md-6">
                <%= f.label :telefono, "Teléfono o WhatsApp", class: "form-label" %>
                <%= f.telephone_field :telefono, class: "form-control", required: true, autocomplete: "tel" %>
              </div>
              <div class="col-md-6">
                <%= f.label :empresa_nombre, "Empresa (opcional)", class: "form-label" %>
                <%= f.text_field :empresa_nombre, class: "form-control", autocomplete: "organization" %>
              </div>
              <div class="col-12">
                <%= f.label :pregunta, "Su pregunta (opcional)", class: "form-label" %>
                <%= f.text_area :pregunta, rows: 3, class: "form-control",
                      placeholder: "Ej: tenemos una denuncia recibida hace una semana y no sabemos quién debería investigarla…" %>
              </div>
            </div>

            <%= f.submit "Enviar y recibir mi resultado por correo", class: "btn btn-primary w-100 mt-3 ls-enviar" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="ls-exito alert alert-success" hidden data-diagnostico-target="exito">
    <h3 class="h5 alert-heading">Resultado en camino</h3>
    <p class="mb-0">Gracias. <strong>Te enviamos el detalle de tu autodiagnóstico a tu correo.</strong>
    Si escribiste una pregunta, nuestro equipo te la responderá dentro de un día hábil.</p>
  </div>
</div>