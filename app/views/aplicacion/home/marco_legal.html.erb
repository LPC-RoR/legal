<% content_for :title, "Marco Legal – Ley Karin | LaborSafe" %>

<section class="marco-legal">
  <div class="container">
    <header class="marco-legal-header">
      <h1>Marco Legal de la Ley Karin</h1>
      <p class="lead">
        Guía completa de la documentación legal que regula la prevención, investigación y
        sanción del acoso laboral, sexual o de violencia en el trabajo en Chile.
        Cada documento enlaza a su fuente oficial.
      </p>
    </header>

    <h2 class="marco-legal-area">Cuerpo principal</h2>
    <div class="marco-legal-grid">
      <%= render partial: "documento_card", collection: @cuerpo_principal, as: :doc %>
    </div>

    <h2 class="marco-legal-area">Documentos referenciados</h2>
    <div class="marco-legal-grid">
      <%= render partial: "documento_card", collection: @docs_referencia, as: :doc %>
    </div>

    <h2 class="marco-legal-area">Leyes modificadas por la Ley N° 21.643</h2>
    <div class="marco-legal-grid">
      <%= render partial: "documento_card", collection: @leyes_modificadas, as: :doc %>
    </div>

    <h2 class="marco-legal-area">Otros documentos</h2>
    <div class="marco-legal-grid">
      <%= render partial: "documento_card", collection: @otros_documentos, as: :doc %>
    </div>
  </div>
</section>