<%# Título sección %>
<div class="my-5 mx-3 mx-md-4 mx-lg-5">
  <div class="border-top mb-1 p-2 text-center">
    <h3 style="font-size: clamp(1.25rem, 2.2vw + 0.5rem, 2rem);">Abogados investigadores</h3>
  </div>
</div>

<%# Grid de abogados %>
<div class="container pb-3 pb-lg-4">
  <div class="row g-3 g-md-4">
    <% @investigadores.each do |abogado| %>
      <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-3">
            <div class="d-flex align-items-center gap-3 mb-2">
              <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                   style="width: 3.5rem; height: 3.5rem; font-size: 1.25rem; background: var(--bs-primary);">
                <%= abogado["iniciales"] %>
              </div>
              <div>
                <h5 class="mb-0 fw-semibold fs-6"><%= abogado["nombre"] %></h5>
                <small class="text-muted"><%= abogado["cargo"] %></small>
              </div>
            </div>
            <p class="text-muted fs-7 mb-2">
              <i class="bi bi-briefcase me-1 text-primary"></i><%= abogado["experiencia"] %> de experiencia
            </p>
 <p class="fs-7 mb-2"><%= abogado["resumen"] %></p>

<% if abogado["biografia"].present? %>
  <div id="bio-<%= abogado["iniciales"].parameterize %>-<%= abogado["experiencia"].parameterize %>">
    <button class="btn btn-link btn-sm p-0 fs-7 text-primary"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#collapse-bio-<%= abogado["iniciales"].parameterize %>-<%= abogado["experiencia"].parameterize %>"
            aria-expanded="false"
            aria-controls="collapse-bio-<%= abogado["iniciales"].parameterize %>-<%= abogado["experiencia"].parameterize %>">
      <i class="bi bi-chevron-down me-1"></i>Ver trayectoria completa
    </button>
    <div class="collapse mt-2" id="collapse-bio-<%= abogado["iniciales"].parameterize %>-<%= abogado["experiencia"].parameterize %>">
      <p class="fs-7 mb-0" style="text-align: justify;"><%= simple_format(abogado["biografia"], {}, wrapper_tag: "span") %></p>
    </div>
  </div>
<% end %>

            <div class="d-flex flex-wrap gap-1">
              <% abogado["especialidades"].each do |esp| %>
                <span class="badge bg-light text-dark border fs-7"><%= esp %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
