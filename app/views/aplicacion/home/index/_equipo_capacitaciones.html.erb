<%# Sección Equipo + Asesorías/capacitaciones (bajo inversion_proceso) %>

<%# 3 Equipo + Capacitaciones %>
<section class="ls-equipo-capacitaciones py-5 bg-light" id="equipo-capacitaciones">
  <div class="container">
    <div class="row g-4 g-lg-5">

      <%# ============ COLUMNA IZQUIERDA: Equipo ============ %>
      <div class="col-lg-6">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4 p-lg-5 d-flex flex-column">
            <h2 class="h4 fw-bold mb-3">
              <i class="bi bi-people-fill text-primary me-2"></i>Nuestro equipo
            </h2>
            <p class="text-secondary flex-grow-1">
              Cada investigación está a cargo de abogados especialistas en derecho laboral, con experiencia en litigación y en procedimientos ante la Dirección del Trabajo. Conozca al equipo que llevará adelante sus investigaciones.
            </p>
            <%= link_to "Conozca nuestro equipo legal especializado", equipo_path,
                        class: "btn btn-primary" %>
          </div>
        </div>
      </div>

      <%# ============ COLUMNA DERECHA: Asesorías y capacitaciones ============ %>
      <div class="col-lg-6">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4 p-lg-5 d-flex flex-column">
            <h2 class="h4 fw-bold mb-3">
              <i class="bi bi-mortarboard-fill text-primary me-2"></i>Capacitaciones
            </h2>
            <p class="text-secondary flex-grow-1">
              Capacite a sus investigadores, al equipo encargado del canal de denuncias o a sus trabajadores, ya sea en cumplimiento del protocolo de prevención o como medida recomendada en una investigación.
            </p>
            <%= link_to "Visite nuestra página de capacitaciones", capacitaciones_path,
                        class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>