<div class="my-5 mx-3 mx-md-4 mx-lg-5">
  <div class="border-bottom mb-1 p-2 text-center">
    <!-- Título fluido entre 1.25rem y 2rem -->
    <h2 style="font-size: clamp(1.25rem, 2.2vw + 0.5rem, 2rem);">Simulador de plazos del procedimiento</h2>
  </div>
</div>

<!-- app/views/home/index.html.erb -->
<div class="container py-3 py-lg-4">
  <div class="row g-3">
    <!-- Timeline: primero en móvil, izquierda en desktop -->
    <div class="col-12 col-lg-8">
      <%= render 'timeline_plazos' %>
    </div>
    
    <!-- Notas: debajo en móvil, derecha en desktop -->
    <div class="col-12 col-lg-4">
      <%= render 'notas_plazos' %>
    </div>
  </div>
</div>

<div class="row gx-3 mx-0 px-3 mx-lg-5 px-lg-5">
	<div class="col-12 col-lg-6">
		<h4>Otras consideraciones</h4>
		<p>Los plazos mostrados corresponden a los máximos establecidos por el reglamento. Si una etapa se cumple antes de su vencimiento, las fechas de las etapas siguientes se recalculan considerando la fecha efectiva de cumplimiento.</p>

		<p>En las investigaciones realizadas por la Dirección del Trabajo no se debe considerar la etapa <i>Pronunciamiento de la Dirección del Trabajo</i>.</p>
	</div>

	<div class="col-12 col-lg-6">
		<%# app/views/home/simulador.html.erb — reemplaza el formulario de leads actual %>

		<% if params[:enviado] %>
		  <div class="alert alert-success d-flex align-items-center gap-2">
		    <i class="bi bi-check-circle-fill"></i>
		    <div>
		      <strong>Simulación enviada.</strong> Revisa tu bandeja de entrada (y el spam, por si acaso).
		    </div>
		  </div>
		<% end %>

		<div class="card border-0 shadow-sm">
		  <div class="card-body p-3 p-sm-4">
		    <h5 class="fw-bold mb-1">
		      <i class="bi bi-envelope-paper me-2 text-primary"></i>
		      Reciba una copia de esta simulación en su correo
		    </h5>
		    <p class="text-muted small mb-3">
		      Déjenos sus datos y le enviaremos el detalle de las fechas proyectadas, listo para compartir con su equipo.
		    </p>

		    <%= form_with model: @lead, url: enviar_simulacion_path, local: true do |f| %>
		      <%= hidden_field_tag :fecha, @fecha_base %>

		      <% if @lead.errors.any? %>
		        <div class="alert alert-danger py-2 small">
		          <ul class="mb-0 ps-3">
		            <% @lead.errors.full_messages.each do |mensaje| %>
		              <li><%= mensaje %></li>
		            <% end %>
		          </ul>
		        </div>
		      <% end %>

		      <div class="row g-2 mb-3">
		        <div class="col-md-6">
		          <%= f.label :nombre, "Su nombre", class: "form-label small fw-medium" %>
		          <%= f.text_field :nombre, class: "form-control form-control-sm",
		                placeholder: "Su nombre", required: true %>
		        </div>
		        <div class="col-md-6">
		          <%= f.label :email, "Su correo de trabajo", class: "form-label small fw-medium" %>
		          <%= f.email_field :email, class: "form-control form-control-sm",
		                placeholder: "nombre@empresa.cl", required: true %>
		        </div>
		        <div class="col-md-6">
		          <%= f.label :telefono, "Teléfono o WhatsApp", class: "form-label small fw-medium" %>
		          <%= f.telephone_field :telefono, class: "form-control form-control-sm",
		                placeholder: "+56 9 ..." %>
		        </div>
				<div class="col-md-6">
				  <%= f.label :empresa_nombre, "Empresa (opcional)", class: "form-label small fw-medium" %>
				  <%= f.text_field :empresa_nombre, class: "form-control form-control-sm",
				        placeholder: "Nombre de su empresa" %>
				</div>
		      </div>

		      <%= f.button type: "submit", class: "btn btn-primary w-100" do %>
		        <i class="bi bi-send me-1"></i> Recibir simulación por correo
		      <% end %>
		    <% end %>
		  </div>
		</div>

	</div>
</div>