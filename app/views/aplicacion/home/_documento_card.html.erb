<article class="documento-card">
  <header class="documento-card-header">
    <h3><%= doc[:cita] %></h3>
    <span class="documento-card-fecha"><%= doc[:fecha] %></span>
  </header>

  <dl class="documento-card-detalle">
    <div class="detalle-item">
      <dt>Entidad responsable</dt>
      <dd><%= doc[:entidad] %></dd>
    </div>
    <div class="detalle-item">
      <dt>Propósito</dt>
      <dd><%= doc[:proposito] %></dd>
    </div>
    <div class="detalle-item">
      <dt>Descripción</dt>
      <dd><%= doc[:descripcion] %></dd>
    </div>
  </dl>

  <div class="documento-card-qr">
    <%= link_to codigo_qr_svg(doc[:url]),
                doc[:url],
                target: "_blank",
                rel: "noopener noreferrer",
                title: "Escanear para abrir: #{doc[:nombre]}" %>
    <span class="documento-card-qr-leyenda">Escanea el código para abrir el documento</span>
  </div>

  <%= link_to doc[:nombre], doc[:url],
              target: "_blank", rel: "noopener noreferrer",
              class: "documento-card-link" %>
</article>