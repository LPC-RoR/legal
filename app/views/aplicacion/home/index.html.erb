<%# aplicacion/home/index.html.erb %>

<% content_for :title, 'Externalización de investigaciones Ley 21.643 | Laborsafe' %>

<%# 1. Hero con captura inmediata %>
<%= render 'aplicacion/home/index/hero' %>

<%# 1.2 Banner de urgencia %>
<%= render 'aplicacion/home/index/urgencia' %>

<%# 2 Nuestro servicio %>
<%= render 'aplicacion/home/index/inversion_proceso' %>
<%# 3 Equipo + Capacitaciones %>
<%= render 'aplicacion/home/index/equipo_capacitaciones' %>

<%# 4 Primer testimonio %>
<%#= render 'aplicacion/home/index/testimonio' %>

<%# 5. Riesgos de una investigación interna %>
<%= render 'aplicacion/home/index/riesgos' %>

<%# 6. Confidencialidad %>
<%= render 'aplicacion/home/index/modelo_confidencialidad' %>

<%# 7. Autodiagnóstico %>
<%= render 'aplicacion/home/index/autodiagnostico' %>

<%# 6. Cierre comercial %>
<section class="py-5 bg-light" id="contacto">
  <div class="container" style="max-width: 640px;">
    <h2 class="text-center mb-3">Conversemos sobre las necesidades de su empresa</h2>
    <p class="text-secondary text-center ls-card-text">
      Cuéntenos cómo gestionan actualmente sus investigaciones y coordinemos una reunión para presentarles nuestro servicio y evaluar cómo podemos apoyarlos.
    </p>

    <%= form_with model: @lead, url: leads_path, class: "mt-4", data: { turbo: false } do |f| %>
      <%= f.hidden_field :kind, value: "presentacion" %>
      <%= hidden_field_tag :form_loaded_at, Time.current.to_i %>
      <%# Honeypot anti-bot: invisible para humanos %>
      <input type="text" name="website" class="ls-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

      <div class="mb-3">
        <%= f.label :nombre, "Su nombre", class: "form-label" %>
        <%= f.text_field :nombre, class: "form-control", required: true, autocomplete: "name" %>
      </div>
      <div class="mb-3">
        <%= f.label :email, "Su correo de trabajo", class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: true, autocomplete: "email" %>
      </div>
      <div class="mb-3">
        <%= f.label :telefono, "Teléfono o WhatsApp", class: "form-label" %>
        <%= f.telephone_field :telefono, class: "form-control", required: true, autocomplete: "tel" %>
      </div>
      <div class="mb-3">
        <%= f.label :empresa_nombre, "Empresa (opcional)", class: "form-label" %>
        <%= f.text_field :empresa_nombre, class: "form-control", autocomplete: "organization" %>
      </div>
      <%= f.submit "Agendar una reunión", class: "btn btn-primary btn-lg" %>
    <% end %>
  </div>
</section>